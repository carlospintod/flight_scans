# --- flight_scans (the Spain-Nairobi tracker) — FREE TIERS ONLY ---
SEARCHAPI_KEY=
RAPIDAPI_KEY=
TRAVELPAYOUTS_TOKEN=
SERPAPI_KEY=

# --- Vuelazo — its own accounts, its own budget ---
# Vuelazo is a separate project that happens to share this repo. Leave
# these blank and it BORROWS the keys above (the run warns, and the
# ledger still caps Vuelazo at its own pool — but the provider allowance
# is then one pot and a deal sweep eats into the tracker's free tier).
# Fill them in and the two projects stop touching each other entirely.
SERPAPI_KEY_VZ=
TRAVELPAYOUTS_TOKEN_VZ=
# No fallback for this one on purpose: SEARCHAPI_KEY is 100 LIFETIME
# credits reserved for the tracker's rectangle sweeps.
SEARCHAPI_KEY_VZ=

# Phone push topic (treat as a password — queue/mistake pushes are how
# Carlos learns there is something to approve). Silent no-op when unset.
NTFY_TOPIC=

# Turso (omit both to run on local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vuelazo service rails (infra secrets — never the /ops key manager)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_PRIVATE_CHANNEL_ID=
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
WEB_URL=

# Web-tier only (Vercel env, listed here for reference):
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SESSION_SECRET, EMAIL_FROM,
# SITE_URL, GH_WORKFLOW_TOKEN, REVALIDATE_SECRET
